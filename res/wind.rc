// Wind 的不可见资源：界面图标 + 程序图标。
// PNG 由 tools/rasterize_icons.py 从 res/icons/*.svg 生成，wind.ico 由 tools/make_app_icon.py
// 从 res/logo.svg 生成，全部直接编译进 exe，
// 运行时用 FindResource / LoadImage 读取，程序因此不依赖 exe 之外的任何文件。

#pragma code_page(65001)  // 源文件是 UTF-8，注释里有中文

#include <winver.h>  // 把 VS_VERSION_INFO 定义成资源 ID 1，否则会被当成字符串名字，版本 API 读不到

#include "resource.h"
#include "wind_version.h"

IDI_WIND_ICON ICON "wind.ico"

IDR_WIND_ICON_PIN RCDATA "icons\\pin.png"
IDR_WIND_ICON_OPACITY RCDATA "icons\\opacity.png"
IDR_WIND_ICON_RESET RCDATA "icons\\reset.png"
IDR_WIND_ICON_CLOSE RCDATA "icons\\close.png"

// 资源管理器「属性 → 详细信息」里看到的版本信息，安装包也靠它判断版本。
// 字符串块的语言是 0x0804（简体中文），码页 1200（Unicode）。
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WIND_VERSION_COMMA
 PRODUCTVERSION WIND_VERSION_COMMA
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L  // VOS_NT_WINDOWS32
 FILETYPE       0x1L      // VFT_APP
 FILESUBTYPE    0x0L      // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Wind"
            VALUE "FileDescription", "Wind 窗口工具"
            VALUE "FileVersion", WIND_VERSION_STRING
            VALUE "InternalName", "Wind"
            VALUE "LegalCopyright", "Copyright (C) Wind"
            VALUE "OriginalFilename", "Wind.exe"
            VALUE "ProductName", "Wind"
            VALUE "ProductVersion", WIND_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
